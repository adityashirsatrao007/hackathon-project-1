# Tracelify Backend Environment Configuration

# Application
APP_NAME=Tracelify
APP_ENV=production
DEBUG=false

# Database (Neon PostgreSQL — get free tier at https://console.neon.tech)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# Security
SECRET_KEY=your-256-bit-secret-key-change-me

# Frontend
FRONTEND_URL=https://tracelify-frontend.vercel.app
BACKEND_URL=https://tracelify-api.onrender.com

# Redis (Use Upstash free tier: https://upstash.com)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# Email Alerts (Optional)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
